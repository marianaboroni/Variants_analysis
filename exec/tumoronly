#!/usr/bin/env Rscript

# Single entry point for the tumoronly package.
#   tumoronly doctor
#   tumoronly prepare-cosmic  --config config.yml [--force]
#   tumoronly run             --config config.yml [--run-id ID]
#   tumoronly annotate-oncokb --run-dir results/ID [--scope retained|all]
#   tumoronly report          --run-dir results/ID
#
# If the package is installed it is loaded with library(); otherwise the R/
# sources are loaded through a SINGLE dev loader (no long source() chains).

`%||%` <- function(a, b) if (is.null(a)) b else a

find_pkg_root <- function() {
  args <- commandArgs(trailingOnly = FALSE)
  file_arg <- sub("^--file=", "", args[grepl("^--file=", args)])
  script <- if (length(file_arg)) normalizePath(file_arg[1]) else NULL
  if (!is.null(script)) {
    # exec/tumoronly (source tree) or <lib>/tumoronly/exec/tumoronly (installed)
    root <- dirname(dirname(script))
    if (dir.exists(file.path(root, "R"))) return(root)
  }
  getwd()
}

load_package <- function() {
  if (requireNamespace("tumoronly", quietly = TRUE)) {
    suppressPackageStartupMessages(library(tumoronly))
    return(invisible(TRUE))
  }
  root <- find_pkg_root()
  r_dir <- file.path(root, "R")
  files <- list.files(r_dir, pattern = "[.]R$", full.names = TRUE)
  first <- file.path(r_dir, c("utils.R", "io.R", "config.R", "input.R"))
  files <- c(intersect(first, files), setdiff(files, first))
  for (f in files) sys.source(f, envir = globalenv())
  Sys.setenv(TUMORONLY_R_DIR = r_dir)
  invisible(FALSE)
}

get_opt <- function(args, name, default = NULL) {
  i <- which(args == name)
  if (length(i) && length(args) >= i[1] + 1) args[i[1] + 1] else default
}
has_flag <- function(args, name) any(args == name)

# resolve a function whether the package is installed (namespace) or dev-sourced (globalenv)
resolve <- function(name) {
  if (requireNamespace("tumoronly", quietly = TRUE) &&
      exists(name, envir = asNamespace("tumoronly"), inherits = FALSE))
    get(name, envir = asNamespace("tumoronly"))
  else get(name, envir = globalenv())
}

main <- function() {
  argv <- commandArgs(trailingOnly = TRUE)
  if (length(argv) == 0) {
    cat("Usage: tumoronly <command> [options]\n",
        "  doctor | prepare-cosmic | run | annotate-oncokb | report\n",
        "  build-cosmic-input --config config.yml [--force]   (build cosmic.raw_file from raw COSMIC v104 files)\n",
        "  prepare-abraom      --config config.yml [--force]   (build population.brazilian.db from an ANNOVAR TSV)\n",
        "  prepare-ancestry-reference --config config.yml\n",
        "  infer-ancestry --run-dir results/ID | ancestry-report --run-dir results/ID\n",
        "  export-review-template --run-dir DIR\n",
        "  import-reviews --file reviews.tsv [--db-dir db/variant_evidence]\n",
        "  training-status | build-training-set --run-dir DIR | train-model |\n",
        "  evaluate-model --model-id ID | activate-model --model-id ID --approve | rollback-model\n",
        "    [--db-dir db/variant_evidence] [--objective P_TRUE_VARIANT]\n", sep = "")
    quit(status = 1)
  }
  cmd <- argv[1]
  args <- argv[-1]
  load_package()
  dbdir <- get_opt(args, "--db-dir", "db/variant_evidence")
  obj <- get_opt(args, "--objective", "P_TRUE_VARIANT")

  ok <- switch(cmd,
    "doctor" = { d <- check_installation(); if (isTRUE(d$ok)) 0 else 1 },
    "prepare-cosmic" = {
      cfg <- get_opt(args, "--config"); if (is.null(cfg)) stop("--config is required")
      prepare_cosmic_db(cfg, force = has_flag(args, "--force")); 0 },
    "build-cosmic-input" = {
      cfg <- get_opt(args, "--config"); if (is.null(cfg)) stop("--config is required")
      res <- build_cosmic_raw_input(cfg, force = has_flag(args, "--force"))
      cat("COSMIC flat input:", res$raw_file_path, "\n",
          "Set this as cosmic.raw_file before running prepare-cosmic.\n"); 0 },
    "prepare-abraom" = {
      cfg <- get_opt(args, "--config"); if (is.null(cfg)) stop("--config is required")
      res <- prepare_brazilian_db(cfg, force = has_flag(args, "--force"))
      cat("Brazilian population DB:", res$db_path, "\n",
          "Set this as population.brazilian.db before running `run`.\n"); 0 },
    "run" = {
      cfg <- get_opt(args, "--config"); if (is.null(cfg)) stop("--config is required")
      run_tumor_only(cfg, run_id = get_opt(args, "--run-id")); 0 },
    "annotate-oncokb" = {
      rd <- get_opt(args, "--run-dir"); if (is.null(rd)) stop("--run-dir is required")
      annotate_oncokb(rd, scope = get_opt(args, "--scope", "retained")); 0 },
    "report" = {
      rd <- get_opt(args, "--run-dir"); if (is.null(rd)) stop("--run-dir is required")
      render_tumor_only_report(rd); 0 },
    "export-review-template" = {
      rd <- get_opt(args, "--run-dir"); if (is.null(rd)) stop("--run-dir is required")
      v <- resolve("read_variants")(file.path(rd, "tables", "variants_all.tsv.gz"), "\t")
      resolve("export_review_template")(v, file.path(rd, "tables", "review_template.tsv"))
      cat("Wrote", file.path(rd, "tables", "review_template.tsv"), "\n"); 0 },
    "import-reviews" = {
      f <- get_opt(args, "--file"); if (is.null(f)) stop("--file is required")
      import_variant_reviews(f, db_dir = dbdir); 0 },
    "training-status" = { resolve("ml_training_status")(dbdir); 0 },
    "build-training-set" = {
      rd <- get_opt(args, "--run-dir"); if (is.null(rd)) stop("--run-dir is required")
      resolve("ml_build_training_set")(dbdir, rd, obj); 0 },
    "train-model" = { resolve("ml_train_model")(dbdir, obj); 0 },
    "evaluate-model" = {
      id <- get_opt(args, "--model-id"); if (is.null(id)) stop("--model-id is required")
      resolve("ml_evaluate_model")(dbdir, id); 0 },
    "activate-model" = {
      id <- get_opt(args, "--model-id"); if (is.null(id)) stop("--model-id is required")
      resolve("ml_activate_model")(dbdir, id, approve = has_flag(args, "--approve")); 0 },
    "rollback-model" = { resolve("ml_rollback_model")(dbdir); 0 },
    "prepare-ancestry-reference" = {
      cfg <- get_opt(args, "--config"); if (is.null(cfg)) stop("--config is required")
      cc <- resolve("read_config")(cfg)
      p <- resolve("load_aims_panel")(cc, resolve("cfg_get")(cc, c("input", "genome_build"), "GRCh38"))
      cat(if (is.null(p)) "No AIMs panel found (set ancestry.marker_panel.path)\n"
          else sprintf("AIMs panel OK: %d markers, version %s\n", nrow(p), attr(p, "version"))); 0 },
    "infer-ancestry" = {
      rd <- get_opt(args, "--run-dir"); if (is.null(rd)) stop("--run-dir is required")
      cc <- tryCatch(resolve("read_config")(file.path(rd, "config.resolved.yml")), error = function(e) list())
      v <- resolve("read_variants")(file.path(rd, "tables", "variants_all.tsv.gz"), "\t")
      build <- resolve("cfg_get")(cc, c("input", "genome_build"), "GRCh38")
      anc <- resolve("infer_ancestry")(v, cc, build)
      resolve("write_tsv")(anc$summary, file.path(rd, "tables", "ancestry_summary.tsv"))
      if (nrow(anc$snps) > 0) resolve("write_tsv")(anc$snps, file.path(rd, "tables", "ancestry_snps.tsv.gz"))
      resolve("write_tsv")(anc$qc, file.path(rd, "tables", "ancestry_qc.tsv"))
      resolve("write_tsv")(anc$projection, file.path(rd, "tables", "ancestry_projection.tsv"))
      resolve("create_ancestry_plots")(anc, file.path(rd, "plots"), cc)
      cat("Ancestry inference written to", file.path(rd, "tables"), "\n"); 0 },
    "ancestry-report" = {
      rd <- get_opt(args, "--run-dir"); if (is.null(rd)) stop("--run-dir is required")
      render_tumor_only_report(rd); 0 },
    { cat(sprintf("Unknown command: %s\n", cmd)); 1 })
  quit(status = ok %||% 0)
}

main()
